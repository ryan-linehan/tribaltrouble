<project name="tt-classpaths" basedir=".">
	<!-- Provide lib variable to find classpaths -->

	<target name="os-check">
		<echo message="${os.name}" />
		<echo message="${os.arch}" />
	</target>

	<!-- Platform conditions to select for platform.classpath -->
	<condition property="platform-natives" value="windows.classpath">
		<os family="windows" />
	</condition>

	<condition property="platform-natives" value="linux.classpath">
		<os name="linux" />
	</condition>

	<condition property="platform-natives" value="macosx.classpath">
		<os name="Mac OS X" arch="x86_64" />
	</condition>

	<condition property="platform-natives" value="macosx-arm64.classpath">
		<os name="Mac OS X" arch="aarch64" />
	</condition>

	<!-- Platform specific classpaths (LWJGL natives from Ivy) -->
	<path id="windows.classpath">
		<fileset dir="${ivy.lib.dir}" erroronmissingdir="false">
			<include name="lwjgl-*-natives-windows.jar" />
		</fileset>
	</path>

	<path id="linux.classpath">
		<fileset dir="${ivy.lib.dir}" erroronmissingdir="false">
			<include name="lwjgl-*-natives-linux.jar" />
		</fileset>
	</path>

	<path id="macosx.classpath">
		<fileset dir="${ivy.lib.dir}" erroronmissingdir="false">
			<include name="lwjgl-*-natives-macos.jar" />
		</fileset>
	</path>

	<path id="macosx-arm64.classpath">
		<fileset dir="${ivy.lib.dir}" erroronmissingdir="false">
			<include name="lwjgl-*-natives-macos-arm64.jar" />
		</fileset>
	</path>

	<!-- Class and build classpaths -->
	<path id="common.classes.classpath">
		<pathelement path="../common/build/classes" />
	</path>

	<path id="common.static.classpath">
		<pathelement location="../common/static" />
	</path>

	<path id="build.classpath">
		<pathelement location="build" />
	</path>

	<path id="build.classes.classpath">
		<pathelement location="build/classes" />
	</path>

	<!-- For tt build.xml, common.xml -->
	<path id="build.tt.classpath">
		<pathelement location="../tt/i18n" />
		<pathelement location="../tt/static" />
	</path>

	<!-- For tools build.xml -->
	<path id="tools.classes.classpath">
		<pathelement path="../tools/build/classes" />
	</path>

	<path id="common.static.fonts.classpath">
		<pathelement path="${commonstatic}/fonts" />
	</path>

	<!-- Jar classpaths: LWJGL core JARs from Ivy, non-Maven JARs from lib -->
	<path id="platform.classpath">
		<!-- Ivy-resolved dependencies -->
		<fileset dir="${ivy.lib.dir}" erroronmissingdir="false">
			<include name="lwjgl-3.*.jar" />
			<include name="lwjgl-opengl-3.*.jar" />
			<include name="lwjgl-openal-3.*.jar" />
			<include name="lwjgl-jawt-3.*.jar" />
			<include name="lwjgl-glfw-3.*.jar" />
			<include name="jorbis-*.jar" />
			<include name="commons-pool-*.jar" />
			<include name="commons-dbcp-*.jar" />
			<include name="commons-collections-*.jar" />
		</fileset>
		<!-- Non-Maven JARs that remain in lib -->
		<fileset dir="${lib}">
			<include name="jsquish.jar" />
			<include name="png.jar" />
		</fileset>
		<path refid="${platform-natives}" />
	</path>

	<!-- Compiling tools uses svnkit, everything else uses javasvn. -->
	<path id="library.svnkit.classpath">
		<pathelement path="../tools/svn/svnkit.jar" />
	</path>

	<path id="library.javasvn.classpath">
		<pathelement path="${lib}/javasvn.jar" />
	</path>

	<path id="server.classpath">
		<fileset dir="${ivy.lib.dir}" erroronmissingdir="false">
			<include name="commons-pool-*.jar" />
			<include name="commons-dbcp-*.jar" />
			<include name="commons-collections-*.jar" />
			<include name="mysql-connector-j-*.jar" />
			<include name="*.jar" />
		</fileset>
	</path>
</project>
